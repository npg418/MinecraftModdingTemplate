{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "com.npg418.examplemod.FabricMain"
      }
    ]
  },
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": "${java_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "fabric-language-kotlin": "${fabric_kotlin_version_range}"
  }
}